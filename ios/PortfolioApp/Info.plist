<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bricolage Grotesque (SIL OFL), copied from PortfolioApp/Resources/Fonts. -->
	<key>UIAppFonts</key>
	<array>
		<string>BricolageGrotesque-SemiBold.ttf</string>
		<string>BricolageGrotesque-Bold.ttf</string>
		<string>BricolageGrotesque-ExtraBold.ttf</string>
	</array>
	<!-- The API runs on a laptop over plain HTTP (http://<laptop-ip>:5080) during
	     development and the demo, so ATS has to allow non-HTTPS loads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>UniMate connects to the UniMate server running on your local network.</string>
</dict>
</plist>
